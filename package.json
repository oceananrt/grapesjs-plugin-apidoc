{
  "name": "grapesjs-plugin-apidoc",
  "version": "0.1.0",
  "description": "GrapesJS plugin — auto-infer REST API endpoints from canvas components and generate OpenAPI 3.1 docs + mock data",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "rollup -c rollup.config.mjs --watch",
    "build": "rollup -c rollup.config.mjs",
    "preview": "npx serve docs"
  },
  "keywords": [
    "grapesjs",
    "plugin",
    "openapi",
    "swagger",
    "api-docs",
    "mock",
    "low-code",
    "postman"
  ],
  "author": "oceananrt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oceananrt/grapesjs-plugin-apidoc"
  },
  "homepage": "https://oceananrt.github.io/grapesjs-plugin-apidoc",
  "bugs": {
    "url": "https://github.com/oceananrt/grapesjs-plugin-apidoc/issues"
  },
  "peerDependencies": {
    "grapesjs": ">=0.22.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "grapesjs": "^0.22.0",
    "rollup": "^4.0.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  }
}
